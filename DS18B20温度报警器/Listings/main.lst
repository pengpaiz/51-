  43   2              LED_25 = 0;
  44   2              LED_30 = 1;
  45   2          }
  46   1          else if(Temp > 20.0)
  47   1          {
  48   2              LED_20 = 0;   // 一灯亮
  49   2              LED_25 = 1;
  50   2              LED_30 = 1;
  51   2          }
  52   1          else
  53   1          {
  54   2              LED_20 = 1;   // 全灭（高电平）
