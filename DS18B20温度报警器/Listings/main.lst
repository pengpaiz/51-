  66          void Buzzer_Control(float Temp)
  67          {
  68   1          unsigned char j;
  69   1          
  70   1          if(Temp > 30.0)
  71   1          {
  72   2              // 产生一定数量的方波脉冲，发出间歇报警声
  73   2              for(j = 0; j < 100; j++)
