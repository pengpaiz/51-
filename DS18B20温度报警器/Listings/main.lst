 130   1          LCD_ShowString(2, 1, "Initializing...");
 131   1          Delay(500);
 132   1          
 133   1          while(1)
 134   1          {
 135   2              /* 温度读取 */
 136   2              DS18B20_ConvertT();      // 启动温度转换
